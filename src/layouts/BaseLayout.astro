---
import '../styles/site.css';
import '../styles/bands.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  pageClass?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  pageClass = '',
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site);

// `astro dev` injects stylesheets as inline <style> tags and talks to Vite over a
// WebSocket. The production build ships external CSS only, so the relaxed
// directives exist in dev and never reach the published pages.
const dev = import.meta.env.DEV;
// The contact form POSTs to the Google Apps Script web app (src/data/contact.ts), which
// answers through a redirect to script.googleusercontent.com.
const formHosts = 'https://script.google.com https://script.googleusercontent.com';
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  dev ? "style-src 'self' 'unsafe-inline'" : "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  dev ? `connect-src 'self' ws: wss: ${formHosts}` : `connect-src 'self' ${formHosts}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---
<!doctype html>
<html lang="it" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1C1C1A" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="preload" href="/assets/fonts/asta-sans-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/asta-sans-extrabold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dymora" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://dymora.eu/images/og-dymora.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dymora: The Art of Living Smart. Una casa illuminata di sera." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://dymora.eu/images/og-dymora.jpg" />
    <title>{title}</title>
    <noscript><link rel="stylesheet" href="/assets/css/nojs.css" /></noscript>
    <slot name="head" />
    <script src="/assets/js/sprite.js" defer></script>
  </head>
  <body class={pageClass}>
    <slot />
  </body>
</html>
