---
// PREVIEW ONLY (branch speedrun/footer-funzioni): candidate visuals for the footer's contact
// block, in place of the hub render, each shown in the real block next to the form. Not in the
// sitemap, noindex. Delete this page, preview-visual.css/.js and preview/ContactVisual.astro once chosen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Headline from '../../components/Headline.astro';
import ContactForm from '../../components/ContactForm.astro';
import ContactVisual from '../../components/preview/ContactVisual.astro';
import '../../styles/footer.css';
import '../../styles/preview-visual.css';

const options = [
  { v: 'd3', n: 1, name: 'La "D" in 3D gira una volta e si assesta' },
  { v: 'draw', n: 2, name: 'La "D" si disegna e si riempie' },
  { v: 'hub', n: 3, name: 'Le funzioni si collegano alla "D"' },
  { v: 'meter', n: 4, name: 'Pannello consumi che si compone' },
] as const;
---
<BaseLayout title="Anteprima — visual dei contatti" description="Anteprima interna dei visual del blocco contatti.">
  <Fragment slot="head"><meta name="robots" content="noindex" /><script src="/assets/js/contact-form.js" defer></script><script src="/assets/js/preview-visual.js" defer></script></Fragment>
  <main>
    <header class="band band--paper pv-top">
      <div class="band__inner pv-top__inner">
        <Eyebrow text="Anteprima interna" />
        <h1 class="h-m">Blocco contatti: <span class="w-accent">quattro visual</span> al posto dell'hub</h1>
        <p class="w-body w-muted">Ogni visual parte una volta quando entra nello schermo; "Rivedi" lo fa ripartire. Con "riduci movimento" attivo si vede solo lo stato finale.</p>
        <nav aria-label="Varianti">
          <ul class="pv-nav">{options.map((o) => <li><a class="tag" href={`#visual-${o.v}`}>{o.n} · {o.name}</a></li>)}</ul>
        </nav>
      </div>
    </header>

    {options.map((o) => (
      <div class="pv-variant">
        <p class="pv-label" id={`visual-${o.v}`}><span>Visual {o.n}</span> {o.name}<button class="pv-replay" type="button" data-vz-replay aria-controls={`blocco-${o.v}`}>Rivedi</button></p>
        <div class="sf">
          <div class="sf__contact" id={`blocco-${o.v}`}>
            <div class="sf__contact-copy">
              <Headline id={`titolo-${o.v}`} size="l" text="Raccontaci di cosa hai **bisogno**." />
              <p class="w-lead sf__muted">Dicci quali sono le tue esigenze in modo da trovare la soluzione che fa per te.</p>
              <a class="h-s sf__mail" href="mailto:info@dymora.eu">info@dymora.eu</a>
              <ContactVisual v={o.v} />
            </div>
            <ContactForm id={`form-${o.v}`} tone="ink" />
          </div>
        </div>
      </div>
    ))}
  </main>
</BaseLayout>
