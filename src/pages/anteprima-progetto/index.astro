---
// PREVIEW ONLY: two candidate scenes for the step "Progettiamo su misura" of the home's
// "Il servizio" (home/Service.astro), side by side so the owner can pick one. Not in the
// sitemap, noindex. Delete this page, src/styles/preview-plan.css and
// public/assets/js/preview-plan.js once chosen.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sprite from '../../components/Sprite.astro';
import '../../styles/service.css';
import '../../styles/preview-plan.css';

// A · the office render, the functions around it light up one by one, each linked to its place.
// Badge at (x, y) in stage units (the stage is 100 × 84.75), its line ends on the building.
const badges = [
  { t: 'Luci', ic: 'luci', side: 'l', y: 20, to: [44, 31] },
  { t: 'Telecamere', ic: 'camera', side: 'l', y: 40, to: [39.8, 41.2] },
  { t: 'Serrature', ic: 'serratura', side: 'l', y: 60, to: [47.6, 49] },
  { t: 'Clima', ic: 'clima', side: 'r', y: 12, to: [60.2, 24.6] },
  { t: 'Allarme', ic: 'allarme', side: 'r', y: 32, to: [68, 34] },
  { t: 'Consumi', ic: 'consumi', side: 'r', y: 52, to: [65, 47.9] },
];
const line = (b: (typeof badges)[number]) => `M${b.side === 'l' ? 21 : 79} ${b.y + 2.5} L${b.to[0]} ${b.to[1]}`;
---
<BaseLayout title="Anteprima — Progettiamo su misura" description="Anteprima interna delle scene per il passo Progettiamo su misura.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="band band--paper pp">
    <div class="band__inner pp__inner">
      <header class="pp__top">
        <p class="w-label eyebrow">Anteprima interna · Il servizio</p>
        <h1 class="h-m">“<span class="w-accent">Progettiamo</span> su misura”: due scene</h1>
        <p class="w-body w-muted">Ogni scena gira da sola, come sul palco della home. “Rivedi” la fa ripartire.</p>
      </header>

      <div class="pp__grid">
      <svg class="pp-icons" width="0" height="0">
        <symbol id="ic-luci" viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z" /></symbol>
        <symbol id="ic-clima" viewBox="0 0 24 24"><path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0zM12 11v6" /></symbol>
        <symbol id="ic-consumi" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></symbol>
        <symbol id="ic-serratura" viewBox="0 0 24 24"><path d="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V7a4 4 0 0 1 8 0v4" /></symbol>
        <symbol id="ic-camera" viewBox="0 0 24 24"><path d="M4 7h10a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM15 10.5l6-3.5v10l-6-3.5" /></symbol>
        <symbol id="ic-allarme" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z" /></symbol>
        <symbol id="ic-casa" viewBox="0 0 24 24"><path d="M3 11 12 4l9 7M5 9.5V20h14V9.5M10 20v-5h4v5" /></symbol>
      </svg>
        <article class="pp-opt" data-pp>
          <div class="pp-opt__head">
            <p class="w-label pp-opt__n">Opzione A</p>
            <h2 class="pp-opt__name">L'ufficio e le sue funzioni</h2>
            <p class="w-body w-muted">Il render dell'ufficio si accende; intorno, le funzioni scelte si illuminano una dopo l'altra, ognuna collegata al suo punto dell'edificio.</p>
          </div>
          <div class="svc__stage pp-opt__stage" aria-hidden="true">
            <div class="svc-scene ppa" data-pp-scene>
              <Sprite name="office_building" variant="light" alt="" class="ppa__bld" preload="lights_on_idle!" />
              <svg class="ppa__links" viewBox="0 0 100 84.75">
                {badges.map((b) => <path pathLength="1" d={line(b)} />)}
                {badges.map((b) => <circle cx={b.to[0]} cy={b.to[1]} r=".9" />)}
              </svg>
              {badges.map((b, i) => (
                <span class:list={['ppa__badge', `ppa__badge--${b.side}`, `ppa__badge--${i + 1}`]}><i><svg viewBox="0 0 24 24"><use href={`#ic-${b.ic}`} /></svg></i>{b.t}</span>
              ))}
              <p class="pp-stamp w-label"><span>Progetto</span> Ufficio · 6 funzioni</p>
            </div>
          </div>
          <button class="pp-opt__replay tag" type="button" data-pp-replay>Rivedi</button>
        </article>

        <article class="pp-opt" data-pp>
          <div class="pp-opt__head">
            <p class="w-label pp-opt__n">Opzione B</p>
            <h2 class="pp-opt__name">Dall'appartamento alla pianta</h2>
            <p class="w-body w-muted">Il render del condominio si accende, si segna il tuo appartamento e si entra: la pianta si disegna, con le funzioni al loro posto (la telecamera all'esterno, sull'ingresso).</p>
          </div>
          <div class="svc__stage pp-opt__stage ppb-stage" aria-hidden="true">
            <div class="svc-scene ppb" data-pp-scene>
              <div class="ppb__grid"></div>
              <div class="ppb__bld">
                <Sprite name="apartment_building" variant="light" alt="" class="ppb__sprite" preload="lights_on_idle!" />
                <span class="ppb-tag ppb__mark"><i><svg viewBox="0 0 24 24"><use href="#ic-casa" /></svg></i><b>Il tuo appartamento</b></span>
              </div>
              <div class="ppb__plan">
                <svg class="ppb__svg" viewBox="0 0 100 70">
                  <g class="ppb__furn">
                    <rect x="9" y="11" width="18" height="3.4" /><rect x="9" y="11" width="3.4" height="14" /><rect x="16" y="19.5" width="10" height="4" rx=".6" />
                    <rect x="36" y="12" width="5.5" height="10" rx="1.2" /><rect x="45" y="12" width="3.2" height="4.4" rx="1.4" /><rect x="44.5" y="18.5" width="4" height="3" rx=".6" />
                    <rect x="22" y="50" width="20" height="5.5" rx="1" /><rect x="22" y="53.7" width="20" height="1.8" rx=".6" /><rect x="26.5" y="42" width="11" height="5" rx=".8" />
                    <rect x="54" y="46" width="12" height="7" rx="1" /><circle cx="56.5" cy="44.6" r=".9" /><circle cx="63.5" cy="44.6" r=".9" /><circle cx="56.5" cy="54.4" r=".9" /><circle cx="63.5" cy="54.4" r=".9" />
                    <rect x="70" y="17" width="16" height="19" rx="1" /><rect x="71.5" y="18.2" width="5.6" height="3" rx=".8" /><rect x="78.9" y="18.2" width="5.6" height="3" rx=".8" /><rect x="52" y="12" width="3.4" height="15" />
                    <circle cx="80" cy="52" r="2" /><circle cx="86.5" cy="49" r="2" /><circle cx="83.2" cy="50.4" r="1.4" />
                  </g>
                  <path class="ppb__rail" pathLength="1" d="M72 60 H92 V40" />
                  <path class="ppb__wall ppb__wall--out" pathLength="1" d="M8 10 H92 V40 H72 V60 H8 Z" />
                  <path class="ppb__wall ppb__wall--in" pathLength="1" d="M34 10 V30 H50 M50 10 V40 H72" />
                  <g class="ppb__open">
                    <rect x="14" y="9" width="10" height="2" /><rect x="40" y="9" width="4" height="2" /><rect x="76" y="9" width="10" height="2" />
                    <rect x="91" y="18" width="2" height="12" /><rect x="36" y="59" width="16" height="2" />
                    <rect x="14" y="59" width="6" height="2" /><rect x="71" y="44" width="2" height="8" />
                    <rect x="44" y="29.4" width="5" height="1.2" /><rect x="54" y="39.4" width="5" height="1.2" />
                  </g>
                  <path class="ppb__glass" d="M14 9.6 H24 M14 10.4 H24 M40 9.6 H44 M40 10.4 H44 M76 9.6 H86 M76 10.4 H86 M91.6 18 V30 M92.4 18 V30 M36 59.6 H52 M36 60.4 H52" />
                  <path class="ppb__door" d="M20 60 V54 A6 6 0 0 0 14 60 M72 44 H78 A8 8 0 0 1 72 52 M44 30 V25 A5 5 0 0 1 49 30 M59 40 V35 A5 5 0 0 0 54 40" />
                </svg>
                <span class="ppb__room ppb__room--cucina">Cucina</span>
                <span class="ppb__room ppb__room--bagno">Bagno</span>
                <span class="ppb__room ppb__room--soggiorno">Soggiorno</span>
                <span class="ppb__room ppb__room--camera">Camera</span>
                <span class="ppb__room ppb__room--terrazzo">Terrazzo</span>
                <span class="ppb-tag ppb-tag--luci"><i><svg viewBox="0 0 24 24"><use href="#ic-luci" /></svg></i><b>Luci</b></span>
                <span class="ppb-tag ppb-tag--clima"><i><svg viewBox="0 0 24 24"><use href="#ic-clima" /></svg></i><b>Clima</b></span>
                <span class="ppb-tag ppb-tag--consumi"><i><svg viewBox="0 0 24 24"><use href="#ic-consumi" /></svg></i><b>Consumi</b></span>
                <span class="ppb-tag ppb-tag--serratura"><i><svg viewBox="0 0 24 24"><use href="#ic-serratura" /></svg></i><b>Serratura</b></span>
                <span class="ppb-tag ppb-tag--camera"><i><svg viewBox="0 0 24 24"><use href="#ic-camera" /></svg></i><b>Telecamera</b></span>
              </div>
              <p class="pp-stamp w-label"><span>Progetto</span> 5 funzioni</p>
            </div>
          </div>
          <button class="pp-opt__replay tag" type="button" data-pp-replay>Rivedi</button>
        </article>
      </div>
    </div>
  </main>
  <script is:inline src="/assets/js/preview-plan.js" defer></script>
</BaseLayout>
