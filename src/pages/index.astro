---
// Home, restructured on 2026-11-24 after the premium smart-home sites (one idea per section,
// product first, scroll storytelling) in the Dymora design: carbon and panna bands alternate,
// the closing banner is orange. Texts from dymora-app design/marketing/copy/it.md, never
// rewritten here: sections only select and order them.
//   opening (ink) → La tua casa in una sola app + Funzioni, the house story (ink)
//   → Il servizio (paper) → Più edifici (ink)
//   → Come si parte (paper) → Domande (ink) → Chiusura (orange) → footer
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/features.css';
import '../styles/home.css';
import '../styles/buildings.css';
import '../styles/reveal.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Opening from '../components/Opening.astro';
import HouseStory from '../components/home/HouseStory.astro';
import Service from '../components/home/Service.astro';
import Buildings from '../components/home/Buildings.astro';
import Steps from '../components/home/Steps.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
---
<BaseLayout title="Dymora — La tua casa. In una sola app." description="Luci, clima, tapparelle, serrature, allarme, telecamere, consumi e irrigazione, con progettazione, installazione, configurazione e assistenza di Dymora." pageClass="home-page">
  <Fragment slot="head"><script is:inline src="/assets/js/reveal.js"></script></Fragment>
  <SiteHeader overlay />
  <main>
    <Opening />
    <HouseStory />
    <Service />
    <Buildings />
    <Steps />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</BaseLayout>
