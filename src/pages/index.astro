---
// Home in the brochure's order (dymora-app design/marketing/dist, 2026-11-23); plan in docs/PLAN-brochure.md.
// Opening: Federico's scroll sequence (commit 5401a7d) instead of the brochure cover, by the owner's choice.
// Texts from dymora-app design/marketing/copy/it.md, never rewritten here.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import '../styles/features.css';
import '../styles/reveal.css';
import SiteFooter from '../components/SiteFooter.astro';
import Opening from '../components/Opening.astro';
import Overview from '../components/home/Overview.astro';
import Multi from '../components/home/Multi.astro';
import Retrofit from '../components/home/Retrofit.astro';
import Away from '../components/home/Away.astro';
import Energy from '../components/home/Energy.astro';
import Security from '../components/home/Security.astro';
import Comfort from '../components/home/Comfort.astro';
import Climate from '../components/home/Climate.astro';
import Irrigation from '../components/home/Irrigation.astro';
import Service from '../components/home/Service.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
---
<BaseLayout title="Dymora — La tua casa. In una sola app." description="Luci, clima, tapparelle, serrature, allarme, telecamere, consumi e irrigazione, con progettazione, installazione, configurazione e assistenza di Dymora." pageClass="home-page">
  <Fragment slot="head"><script is:inline src="/assets/js/reveal.js"></script></Fragment>
  <main>
    <Opening />
    <Overview />
    <Multi />
    <Retrofit />
    <Away />
    <Energy />
    <Security />
    <Comfort />
    <Climate />
    <Irrigation />
    <Service />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
</BaseLayout>
