---
// Former page of the function, kept as a redirect to its chapter on /funzioni/ so old links work.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHead from '../../components/PageHead.astro';
import '../../styles/legal.css';
---
<BaseLayout title="Funzioni Dymora" description="Questa pagina si è spostata nella pagina Funzioni." canonical="/funzioni/" pageClass="page-moved">
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/funzioni/#consumi" />
  </Fragment>
  <SiteHeader />
  <main>
    <PageHead eyebrow="Funzioni" title="Questa pagina si è **spostata**.">
      <p class="w-lead w-muted page-head__links">La trovi nella <a href="/funzioni/#consumi">pagina Funzioni</a>.</p>
    </PageHead>
  </main>
  <SiteFooter />
</BaseLayout>
