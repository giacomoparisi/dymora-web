---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Pagina non trovata — Dymora" description="La pagina richiesta non esiste." canonical="/404.html">
  <meta slot="head" name="robots" content="noindex" />
  <SiteHeader />
  <main class="legal-page"><p class="w-label w-eyebrow">Errore 404</p><h1 class="w-title">Questa pagina non c'è.</h1><p class="w-lead">Torna alla <a href="/">home di Dymora</a> o scrivi a <a href="mailto:info@dymora.eu">info@dymora.eu</a>.</p></main>
  <SiteFooter />
</BaseLayout>
