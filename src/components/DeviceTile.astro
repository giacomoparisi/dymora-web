---
// A device card like the app's tiles: the animated scene, its name, a state.
// With `toggle`, the state is a button that plays the scene's layers in and out
// (sprite.js data-sprite-target). Nothing commands a real device.
import Sprite from './Sprite.astro';

interface Props {
  id: string;
  sprite: string;
  variant?: 'light' | 'dark';
  /** Layers at start. */
  layers?: string;
  play?: boolean;
  name: string;
  /** Small text over the name: room, power. */
  meta?: string;
  /** Static state chip, when there is no toggle. */
  state?: string;
  stateTone?: 'on' | 'off';
  /** Layers the button switches, and the state words for on and off. */
  toggle?: { layer: string; on: string; off: string; pressed?: boolean };
  class?: string;
}
const p = Astro.props;
---
<div class:list={['tile', 'dev-tile', p.class]}>
  {p.meta && <p class="w-label tile__label dev-tile__meta">{p.meta}</p>}
  <Sprite id={p.id} name={p.sprite} variant={p.variant} layers={p.layers} play={p.play} alt="" class="dev-tile__scene" />
  {p.toggle ? (
    <button class="tag dev-tile__state" type="button" aria-label={p.name} aria-pressed={p.toggle.pressed ? 'true' : 'false'} data-sprite-target={p.id} data-sprite-layer={p.toggle.layer}>
      <span class="is-on" aria-hidden="true">{p.toggle.on}</span><span class="is-off" aria-hidden="true">{p.toggle.off}</span>
    </button>
  ) : p.state && <span class:list={['tag', 'dev-tile__state', `dev-tile__state--${p.stateTone ?? 'on'}`]}>{p.state}</span>}
  <p class="w-body-strong dev-tile__name">{p.name}</p>
  <slot />
</div>
