---
// The home's detail popup for the functions without a page of their own (`popupFeatures`):
// one native <dialog> per function, id `funzione-<slug>`, opened by
// public/assets/js/feature-dialog.js from the cards of FeatureLinks.astro (href `/#funzione-<slug>`).
// Without JavaScript, feature-dialog.css shows the targeted dialog in place under the cards.
// Rendered outside the band's inner box so reveal.js never marks a dialog.
import Headline from './Headline.astro';
import HouseHero from './HouseHero.astro';
import { features, popupFeatures } from '../data/features';
import '../styles/feature-dialog.css';

const n = popupFeatures.length;
---
{popupFeatures.map((f, i) => {
  const prev = popupFeatures[(i - 1 + n) % n];
  const next = popupFeatures[(i + 1) % n];
  const titleId = `funzione-${f.slug}-title`;
  const subject = encodeURIComponent(`Richiesta di consulenza ${f.label}`);
  const media = f.image || f.house;
  return (
    <dialog class="fdialog" id={`funzione-${f.slug}`} data-feature-dialog={f.slug} aria-labelledby={titleId}>
      <div class="fdialog__panel">
        <div class="fdialog__bar">
          <p class="w-label eyebrow fdialog__label">{String(features.indexOf(f) + 1).padStart(2, '0')} · {f.label}</p>
          <a class="fdialog__close" href="#funzioni" data-fd-close aria-label="Chiudi"></a>
        </div>
        <div class:list={['fdialog__body', { 'fdialog__body--media': media }]}>
          <div class="fdialog__copy">
            <Headline id={titleId} size="m" text={f.title} />
            <p class="w-body fdialog__line">{f.line}</p>
            <ul class="w-body points fdialog__points">
              {f.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          {f.image ? (
            <figure class="fdialog__media">
              <img src={f.image.src} alt={f.image.alt} width={f.image.width} height={f.image.height} loading="lazy" decoding="async" />
            </figure>
          ) : f.house && (
            <div class="fdialog__media fdialog__media--house">
              <HouseHero id={`fd-house-${f.slug}`} layers={f.house.layers} alt={f.house.alt} buttons={f.house.buttons} />
            </div>
          )}
        </div>
        <p class="w-note fdialog__note">{media ? 'Immagini dimostrative. ' : ''}Funzioni e rilevamenti dipendono dai dispositivi e dalla configurazione scelta.</p>
        <div class="fdialog__actions">
          <a class="w-cta w-button" href={`mailto:info@dymora.eu?subject=${subject}`}>Richiedi una consulenza</a>
        </div>
        <nav class="fdialog__nav" aria-label="Altre funzioni">
          <a class="fdialog__step fdialog__step--prev" href={prev.href} data-fd-go={prev.slug}><span class="w-label">Precedente</span>{prev.label}</a>
          <a class="fdialog__step fdialog__step--next" href={next.href} data-fd-go={next.slug}><span class="w-label">Successiva</span>{next.label}</a>
        </nav>
      </div>
    </dialog>
  );
})}
<script is:inline src="/assets/js/feature-dialog.js" defer></script>
