---
// Request form (sopralluogo, demo, informazioni). For now it sends nothing itself: on submit
// `contact-form.js` checks the fields and opens the visitor's mail app with a ready message
// to info@dymora.eu, so no data reaches a third party and /privacy/ and the CSP stay as they are.
// Without JavaScript the form is hidden (nojs.css) and the plain mail link shows instead.
// `id` keeps the field ids unique when the form appears more than once on a page.
// `tone` follows the band behind it: `ink` on carbon, `paper` on light surfaces.
import '../styles/contact-form.css';

interface Props {
  id?: string;
  tone?: 'ink' | 'paper';
  class?: string;
}
const { id = 'cf', tone = 'ink', class: className } = Astro.props;
const f = (name: string) => `${id}-${name}`;
const kinds = ['Sopralluogo', 'Demo', 'Informazioni'];
const slots = ['Mattina', 'Pomeriggio', 'Indifferente'];
---
<form class:list={['cf', `cf--${tone}`, className]} action="#" method="post" novalidate data-contact-form data-to="info@dymora.eu" aria-labelledby={f('title')}>
  <p class="h-s cf__title" id={f('title')}>Richiedi un sopralluogo o una demo</p>
  <div class="cf__summary" role="alert" tabindex="-1" hidden data-cf-summary></div>

  <fieldset class="cf__group">
    <legend class="w-label cf__legend">Cosa ti serve</legend>
    <div class="cf__chips">
      {kinds.map((k, i) => (
        <label class="cf__chip"><input type="radio" name="kind" value={k} checked={i === 0} /><span>{k}</span></label>
      ))}
    </div>
  </fieldset>

  <div class="cf__row">
    <div class="cf__field">
      <label for={f('name')}>Nome e cognome <span aria-hidden="true">*</span></label>
      <input id={f('name')} name="name" type="text" autocomplete="name" required />
      <p class="cf__error" id={f('name-error')}></p>
    </div>
    <div class="cf__field">
      <label for={f('company')}>Azienda <span class="cf__opt">(facoltativo)</span></label>
      <input id={f('company')} name="company" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="cf__row">
    <div class="cf__field">
      <label for={f('email')}>Email <span aria-hidden="true">*</span></label>
      <input id={f('email')} name="email" type="email" inputmode="email" autocomplete="email" required />
      <p class="cf__error" id={f('email-error')}></p>
    </div>
    <div class="cf__field">
      <label for={f('phone')}>Telefono <span class="cf__opt">(facoltativo)</span></label>
      <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" />
    </div>
  </div>

  <fieldset class="cf__group">
    <legend class="w-label cf__legend">Quando preferisci essere ricontattato</legend>
    <div class="cf__chips">
      {slots.map((s, i) => (
        <label class="cf__chip"><input type="radio" name="slot" value={s} checked={i === slots.length - 1} /><span>{s}</span></label>
      ))}
    </div>
  </fieldset>

  <div class="cf__field">
    <label for={f('message')}>Cosa vuoi tenere sotto controllo? <span class="cf__opt">(facoltativo)</span></label>
    <textarea id={f('message')} name="message" rows="4"></textarea>
  </div>

  <div class="cf__send">
    <button class="w-cta w-button cf__submit" type="submit">Invia la richiesta</button>
    <p class="w-note cf__note">Si apre la tua app di posta con il messaggio già pronto. Trattiamo i dati come descritto nella <a href="/privacy/">Privacy</a>.</p>
  </div>
  <div class="cf__status" role="status" aria-live="polite" hidden data-cf-status></div>
</form>
<p class="cf-nojs">Scrivici a <a href="mailto:info@dymora.eu?subject=Richiesta%20di%20sopralluogo%20o%20demo">info@dymora.eu</a>: raccontaci cosa ti serve e come ricontattarti.</p>
