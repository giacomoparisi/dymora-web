---
// Request form for a sopralluogo or a demo. `contact-form.js` checks the fields, then:
// - with `contact.endpoint` set (src/data/contact.ts), it POSTs the request to the Google Apps
//   Script web app, which mails it to info@dymora.eu (integrations/google-apps-script/);
// - with the endpoint empty, it opens the visitor's mail app with a ready message, as before.
// If the POST fails, the status offers that same ready message as a fallback.
// Without JavaScript the form is hidden (nojs.css) and the plain mail link shows instead.
// `id` keeps the field ids unique when the form appears more than once on a page.
// `tone` follows the band behind it: `ink` on carbon, `paper` on light surfaces.
import '../styles/contact-form.css';
import { contact } from '../data/contact';

interface Props {
  id?: string;
  tone?: 'ink' | 'paper';
  class?: string;
}
const { id = 'cf', tone = 'ink', class: className } = Astro.props;
const f = (name: string) => `${id}-${name}`;
const sends = Boolean(contact.endpoint);
---
<form class:list={['cf', `cf--${tone}`, className]} action="#" method="post" novalidate data-contact-form data-to={contact.email} data-endpoint={contact.endpoint || undefined} aria-label="Richiesta di sopralluogo o demo">
  <div class="cf__summary" role="alert" tabindex="-1" hidden data-cf-summary></div>

  <div class="cf__row">
    <div class="cf__field">
      <label for={f('name')}>Nome e cognome <span aria-hidden="true">*</span></label>
      <input id={f('name')} name="name" type="text" autocomplete="name" maxlength="200" required />
      <p class="cf__error" id={f('name-error')}></p>
    </div>
    <div class="cf__field">
      <label for={f('company')}>Azienda <span class="cf__opt">(facoltativo)</span></label>
      <input id={f('company')} name="company" type="text" autocomplete="organization" maxlength="200" />
    </div>
  </div>

  <div class="cf__row">
    <div class="cf__field">
      <label for={f('email')}>Email <span aria-hidden="true">*</span></label>
      <input id={f('email')} name="email" type="email" inputmode="email" autocomplete="email" maxlength="200" required />
      <p class="cf__error" id={f('email-error')}></p>
    </div>
    <div class="cf__field">
      <label for={f('phone')}>Telefono <span class="cf__opt">(facoltativo)</span></label>
      <input id={f('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="200" />
    </div>
  </div>

  <div class="cf__field">
    <label for={f('message')}>Quali sono le tue esigenze? <span class="cf__opt">(facoltativo)</span></label>
    <textarea id={f('message')} name="message" rows="4" maxlength="3000"></textarea>
  </div>

  {sends && (
    <div class="cf__trap" aria-hidden="true">
      <label for={f('website')}>Non compilare questo campo</label>
      <input id={f('website')} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
  )}

  <div class="cf__send">
    <button class="w-cta w-button cf__submit" type="submit" data-cf-submit>Invia la richiesta</button>
    <p class="w-note cf__note">
      {sends ? 'Trattiamo i dati come descritto nella ' : 'Si apre la tua app di posta con il messaggio già pronto. Trattiamo i dati come descritto nella '}<a href="/privacy/">Privacy</a>.
    </p>
  </div>
  <div class="cf__status" role="status" aria-live="polite" hidden data-cf-status></div>
</form>
<p class="cf-nojs">Scrivici a <a href={`mailto:${contact.email}?subject=Richiesta%20di%20sopralluogo%20o%20demo`}>{contact.email}</a>: raccontaci cosa ti serve e come ricontattarti.</p>
