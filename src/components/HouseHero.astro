---
// The overview's house (dark), with only one function playing in: the hero of a function's page
// (FeaturePage.astro) and the picture of a home popup without an app screen (FeatureDialog.astro).
// Each button toggles its layers on the house (sprite.js data-sprite-target), as the overview's
// tags do on the home. Layer tokens and paint order from src/data/intro.ts.
import Sprite from './Sprite.astro';
import { overview } from '../data/intro';
import '../styles/house-hero.css';

interface Props {
  /** Layers playing in when the house shows, on top of the balustrade. */
  layers: string;
  alt: string;
  buttons: { label: string; layer: string; pressed: boolean }[];
  /** The scene's id, which the buttons target: unique on the page. */
  id?: string;
}
const { layers, alt, buttons, id = 'fp-house' } = Astro.props;
---
<div class="house-hero">
  <Sprite id={id} name="house" variant="dark" layers={`balustrade_off ${layers}`} order={overview.order} play alt={alt} class="house-hero__scene" />
  <div class="house-hero__buttons">
    {buttons.map((b) => (
      <button class="tag house-hero__btn" type="button" aria-pressed={b.pressed ? 'true' : 'false'} data-sprite-target={id} data-sprite-layer={b.layer}>{b.label}</button>
    ))}
  </div>
</div>
