---
// Site header, on every page. Carbon glass bar, sticky; on the home (`overlay`) it floats over the
// opening, transparent until the page scrolls (header.js sets .is-scrolled).
// "Funzioni" opens a mega menu with the eight functions (device render, name, the copy's `line`):
// hover or click on wide screens, an accordion inside the burger panel on phones.
// On the home the functions without a page open their popup (data-feature, feature-dialog.js).
// Without JavaScript the menu opens on hover and focus (header.css), the panel stays reachable.
import { features } from '../data/features';
import '../styles/header.css';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---
<header class:list={['sh', { 'sh--overlay': overlay }]} data-sh>
  <div class="sh__bar">
    <a class="sh__logo" href="/" aria-label="Dymora, pagina iniziale"><img src="/assets/images/logo-word-white.svg" alt="Dymora" width="144" height="30" /></a>
    <nav class="sh__nav" id="sh-panel" aria-label="Navigazione principale">
      <ul class="sh__menu">
        <li class="sh__item sh__item--mega" data-sh-mega>
          <button class="sh__link sh__trigger" type="button" aria-expanded="false" aria-controls="sh-funzioni">Funzioni<span class="sh__chev" aria-hidden="true"></span></button>
          <div class="sh__mega" id="sh-funzioni">
            <div class="sh__mega-inner">
              <p class="w-label eyebrow sh__mega-label">Cosa puoi fare con Dymora</p>
              <ul class="sh__grid">
                {features.map((f, i) => (
                  <li>
                    <a class="sh__fn" href={f.href} data-feature={f.page ? undefined : f.slug}>
                      <span class="sh__fn-media" aria-hidden="true"><img src={f.device.src} width={f.device.width} height={f.device.height} alt="" loading="lazy" decoding="async" /></span>
                      <span class="sh__fn-text">
                        <span class="w-label sh__fn-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <span class="sh__fn-name">{f.label}</span>
                        <span class="sh__fn-line">{f.line}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
        <li class="sh__item"><a class="sh__link" href="/#edifici">Più edifici</a></li>
        <li class="sh__item"><a class="sh__link" href="/#servizio">Servizio</a></li>
        <li class="sh__item"><a class="sh__link" href="/#domande">Domande</a></li>
        <li class="sh__item sh__item--panel-cta"><a class="w-cta w-button" href="/#contatti">Richiedi una consulenza</a></li>
      </ul>
    </nav>
    <div class="sh__end">
      <a class="w-cta w-button sh__cta" href="/#contatti">Richiedi una consulenza</a>
      <button class="sh__burger" type="button" aria-expanded="false" aria-controls="sh-panel" aria-label="Apri il menu"><span></span></button>
    </div>
  </div>
</header>
<script is:inline src="/assets/js/header.js" defer></script>
