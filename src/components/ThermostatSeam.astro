---
// The thermostat's one lamp, the seam between its pads, lit as the app draws it
// (dymora-app ThermostatArt.kt, `drawThermostatSeam`): in the scene's own coordinates
// (402 × 527, art/thermostat/sprites.json, anchor `seam`), the parallelogram
// centre ± u ± v for the line, and two additive glows across it, the core and the bloom.
// Laid over the thermostat's Sprite; feature-links.css lights it while the card is
// hovered or focused and lets its glow breathe as the app's does while running.
// Colour: the heating mode's, the app's default (#F45118).
---
<svg class="tseam" viewBox="0 0 402 527" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="tseam-bloom" gradientUnits="userSpaceOnUse" x1="273.48" y1="0" x2="309.90" y2="0">
      <stop offset="0" stop-color="#F45118" stop-opacity="0" />
      <stop offset=".5" stop-color="#F45118" stop-opacity=".35" />
      <stop offset="1" stop-color="#F45118" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="tseam-core" gradientUnits="userSpaceOnUse" x1="286.41" y1="0" x2="296.97" y2="0">
      <stop offset="0" stop-color="#F45118" stop-opacity="0" />
      <stop offset=".5" stop-color="#F45118" stop-opacity=".9" />
      <stop offset="1" stop-color="#F45118" stop-opacity="0" />
    </linearGradient>
  </defs>
  <g class="tseam__glow">
    <polygon points="273.48,354.89 309.90,340.23 309.90,177.07 273.48,191.73" fill="url(#tseam-bloom)" />
    <polygon points="286.41,349.69 296.97,345.43 296.97,182.27 286.41,186.53" fill="url(#tseam-core)" />
  </g>
  <polygon class="tseam__line" points="290.48,348.05 292.90,347.07 292.90,183.91 290.48,184.89" fill="#F45118" />
</svg>
