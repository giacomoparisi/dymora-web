---
// "Cosa puoi fare con Dymora": one card per function of the brochure (`overview.labels`),
// to its page or, for the functions without one, to its popup on the home (`/#funzione-<slug>`). On a feature page `current` leaves that page out and the title
// becomes "Scopri anche" instead of the home's section title. On the home (no `current`) the
// popups are rendered here (FeatureDialog.astro) and open in place.
import Band from './Band.astro';
import Eyebrow from './Eyebrow.astro';
import Headline from './Headline.astro';
import FeatureDialog from './FeatureDialog.astro';
import { features, plain } from '../data/features';
import '../styles/feature-links.css';

interface Props {
  tone?: 'ink' | 'paper';
  current?: string;
  id?: string;
}
const { tone = 'ink', current, id } = Astro.props;
const list = features.filter((f) => f.slug !== current);
const popup = !current;
const titleId = `${id ?? current ?? 'funzioni'}-links-title`;
---
<Band tone={tone} id={id} class="flinks" labelledby={titleId} innerClass="flinks__inner">
  <div class="flinks__head">
    <Eyebrow text="Funzioni" />
    <Headline id={titleId} size={current ? 'm' : 'l'} text={current ? 'Scopri anche le **altre funzioni**.' : 'Cosa puoi fare con **Dymora**.'} />
  </div>
  <ul class:list={['flinks__list', { 'flinks__list--7': list.length === 7 }]}>
    {list.map((f) => (
      <li>
        <a class="flink" href={f.href} data-feature={popup && !f.page ? f.slug : undefined}>
          <span class="w-label flink__num" aria-hidden="true">{String(features.indexOf(f) + 1).padStart(2, '0')}</span>
          <span class="flink__name">{f.label}</span>
          <span class="w-note flink__line">{plain(f.title)}</span>
          <span class="flink__arrow" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</Band>
{popup && <FeatureDialog />}
