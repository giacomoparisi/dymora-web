---
// "Cosa puoi fare con Dymora": one card per function of the brochure (`overview.labels`), each with
// the render of a device that stands for it (`device` in features.ts), linking
// to its page or, for the functions without one, to its popup on the home (`/#funzione-<slug>`). On a feature page `current` leaves that page out and the title
// becomes "Scopri anche" instead of the home's section title. On the home (no `current`) the
// popups are rendered here (FeatureDialog.astro) and open in place.
import Band from './Band.astro';
import Eyebrow from './Eyebrow.astro';
import Headline from './Headline.astro';
import FeatureDialog from './FeatureDialog.astro';
import Sprite from './Sprite.astro';
import ThermostatSeam from './ThermostatSeam.astro';
import { features } from '../data/features';
import '../styles/feature-links.css';

interface Props {
  tone?: 'ink' | 'paper';
  current?: string;
  id?: string;
}
const { tone = 'ink', current, id } = Astro.props;
const list = features.filter((f) => f.slug !== current);
const popup = !current;
const titleId = `${id ?? current ?? 'funzioni'}-links-title`;
// The scenes in the band's variant: the white renders on carbon, the dark ones on panna.
const variant = tone === 'ink' ? 'dark' : 'light';
---
<Band tone={tone} id={id} class="flinks" labelledby={titleId} innerClass="flinks__inner">
  <div class="flinks__head">
    <Eyebrow text="Funzioni" />
    <Headline id={titleId} size={current ? 'm' : 'l'} text={current ? 'Scopri anche le **altre funzioni**.' : 'Cosa puoi fare con **Dymora**.'} />
  </div>
  <ul class:list={['flinks__list', { 'flinks__list--7': list.length === 7 }]}>
    {list.map((f) => (
      <li>
        <a class:list={['flink', `flink--${f.slug}`]} href={f.href} data-feature={popup && !f.page ? f.slug : undefined}>
          <span class="flink__media" aria-hidden="true">
            {f.scene ? (
              <span class="flink__scene" data-fx-on={f.scene.on || undefined} data-fx-then={f.scene.then} data-fx-wait={f.scene.wait} data-fx-off={f.scene.off}>
                <Sprite name={f.scene.name} variant={variant} order={f.scene.order} preload={[f.scene.on, f.scene.then, f.scene.off].filter(Boolean).join(' ')} alt="" class="flink__device" tag="span" />
                {f.scene.name === 'thermostat' && <ThermostatSeam />}
              </span>
            ) : (
              <img class="flink__device" src={f.device.src} width={f.device.width} height={f.device.height} alt="" loading="lazy" decoding="async" />
            )}
          </span>
          <span class="w-label flink__num" aria-hidden="true">{String(features.indexOf(f) + 1).padStart(2, '0')}</span>
          <span class="flink__name">{f.label}</span>
          <span class="flink__arrow" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</Band>
{popup && <FeatureDialog />}
<script is:inline src="/assets/js/feature-fx.js" defer></script>
