---
// PREVIEW ONLY (anteprima-chiusura): candidate visuals for the footer's contact block, in place
// of the hub render. Each plays once when it comes into view (preview-visual.js adds `is-in`);
// under reduced motion each shows its final state. Delete with the preview page once chosen.
//   d3:    the logo's "D" in 3D turns once on itself and settles
//   draw:  the "D" is drawn as an orange line, then fills
//   hub:   the functions connect one after another to the "D" at the centre
//   meter: a small consumption panel fills in (kWh counter, hourly bars, zones)
interface Props {
  v: 'd3' | 'draw' | 'hub' | 'meter';
}
const { v } = Astro.props;
const D = 'M517.03,157.5c0,-17.95 -14.55,-32.51 -32.51,-32.51h-59.29c-17.96,0 -32.51,-14.55 -32.51,-32.51v-59.98c0,-17.95 -14.55,-32.51 -32.51,-32.51H45.97C28.02,0 13.47,14.55 13.47,32.51v59.98c0,17.95 14.55,32.51 32.51,32.51h312.59c17.95,0 32.51,14.55 32.51,32.51v18.56s0,0.02 0,0.04v46.67c0,15.67 -12.7,28.37 -28.37,28.37H79.29c-12.43,0 -24.06,6.13 -31.09,16.38l-43,62.74c-12.46,18.18 -1.37,45.77 20.68,45.77 1.16,0 338.48,0.11 338.48,0.11 15.67,0 28.37,-12.7 28.37,-28.37v-68.26c0,-15.67 12.7,-28.37 28.37,-28.37h67.56c15.67,0 28.37,-12.7 28.37,-28.37v-46.67s0,-0.02 0,-0.04v-18.56Z';
const box = '0 0 517.03 376.12';
const layers = Array.from({ length: 18 });
const fns = ['Luci', 'Clima', 'Tapparelle', 'Serrature', 'Allarme', 'Telecamere', 'Consumi', 'Irrigazione'];
// Ends of the connecting lines, on a circle around the centre of a 100×100 box (same angles as the pills in CSS).
const ends = fns.map((_, i) => {
  const a = (i / fns.length) * 2 * Math.PI - Math.PI / 2;
  return { x: (50 + 36 * Math.cos(a)).toFixed(2), y: (50 + 36 * Math.sin(a)).toFixed(2) };
});
const bars = Array.from({ length: 12 });
---
{v === 'd3' && (
  <div class="vz vz-d3" data-vz role="img" aria-label="Il simbolo Dymora">
    <div class="vz-d3__obj">
      {layers.map(() => <svg class="vz-d3__layer" viewBox={box} aria-hidden="true"><path d={D} /></svg>)}
    </div>
  </div>
)}

{v === 'draw' && (
  <div class="vz vz-draw" data-vz role="img" aria-label="Il simbolo Dymora">
    <svg viewBox="-12 -12 541.03 400.12" aria-hidden="true"><path d={D} pathLength="1" /></svg>
  </div>
)}

{v === 'hub' && (
  <div class="vz vz-hub" data-vz role="img" aria-label={`Il simbolo Dymora collegato a ${fns.join(', ')}`}>
    <svg class="vz-hub__lines" viewBox="0 0 100 100" aria-hidden="true">
      {ends.map((e) => <line x1="50" y1="50" x2={e.x} y2={e.y} pathLength="1" />)}
    </svg>
    <span class="vz-hub__pulse" aria-hidden="true"></span>
    <svg class="vz-hub__mark" viewBox={box} aria-hidden="true"><path d={D} /></svg>
    <ul class="vz-hub__fns" aria-hidden="true">{fns.map((f) => <li>{f}</li>)}</ul>
  </div>
)}

{v === 'meter' && (
  <div class="vz vz-meter" data-vz>
    <div class="vz-meter__head">
      <p class="w-label">Consumi · oggi</p>
      <p class="vz-meter__num"><span data-vz-count data-to="128.4">128,4</span> <small>kWh</small></p>
    </div>
    <div class="vz-meter__bars" aria-hidden="true">{bars.map(() => <span></span>)}</div>
    <ul class="vz-meter__zones">
      <li><span>Open space</span><span class="vz-meter__track"><span></span></span><span class="vz-meter__val">62 kWh</span></li>
      <li><span>Sale riunioni</span><span class="vz-meter__track"><span></span></span><span class="vz-meter__val">38 kWh</span></li>
      <li><span>Area relax</span><span class="vz-meter__track"><span></span></span><span class="vz-meter__val">28 kWh</span></li>
    </ul>
  </div>
)}
