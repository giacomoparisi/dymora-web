---
// Preview only: a function's device scene (features.ts `scene`), switched on by
// preview-features.js when its owner ([data-fx-card]) is active.
import Sprite from '../Sprite.astro';
import ThermostatSeam from '../ThermostatSeam.astro';
import type { Feature } from '../../data/features';

interface Props {
  f: Feature;
  variant?: 'light' | 'dark';
  class?: string;
}
const { f, variant = 'dark', class: className } = Astro.props;
const s = f.scene!;
---
<span class:list={['pfx', `pfx--${f.slug}`, className]} data-fx-on={s.on || undefined} data-fx-then={s.then} data-fx-wait={s.wait} data-fx-off={s.off} aria-hidden="true">
  <Sprite name={s.name} variant={variant} order={s.order} preload={[s.on, s.then, s.off].filter(Boolean).join(' ')} alt="" tag="span" class="pfx__sprite" />
  {s.name === 'thermostat' && <ThermostatSeam />}
</span>
