---
// The Dymora lockup as the app's splash plays it (dymora-app DymoraSplashBrand.kt, paths from
// BrandPaths.kt): the mark alone at the centre, then the row opens from the centre and the letters
// of the wordmark come in one after another. `lockup.js` plays it once when it comes into view;
// without JavaScript or under reduced motion the whole lockup stands still. White only, no orange.
// Geometry in the splash's dp: mark 88 × 64.02, wordmark 156.73 × 16 at (104, 24.01).
import '../styles/lockup.css';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
