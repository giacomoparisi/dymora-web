---
// A function told as one large chapter: copy on one side (`feature.*` eyebrow, title, line,
// points), its pictures on the other (`media` in features.ts), which drift at different speeds
// while the section scrolls (spotlight.css, scroll-driven where supported). A function without
// pictures shows the overview's house with only that function playing (HouseHero.astro).
// Used on /funzioni/ for every function.
import Band from '../Band.astro';
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';
import HouseHero from '../HouseHero.astro';
import { feature } from '../../data/features';
import '../../styles/spotlight.css';

interface Props {
  slug: string;
  tone: 'ink' | 'paper';
  flip?: boolean;
  /** The section's id; `spot-<slug>` by default. */
  id?: string;
}
const { slug, tone, flip = false, id = `spot-${slug}` } = Astro.props;
const f = feature(slug);
const titleId = `spot-${slug}-title`;
const [main, ...extra] = f.media ?? [];
const subject = encodeURIComponent(`Richiesta di consulenza ${f.label}`);
---
<Band tone={tone} id={id} class:list={['spot', `spot--${slug}`, { 'spot--flip': flip }]} labelledby={titleId} innerClass="spot__inner">
  <div class="spot__copy">
    <Eyebrow text={f.eyebrow} />
    <Headline id={titleId} size="l" text={f.title} />
    <p class="w-lead w-muted">{f.line}</p>
    {f.points.length > 0 && <ol class="spot__points">
      {f.points.map((p, i) => <li><span class="w-label spot__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="w-body">{p}</span></li>)}
    </ol>}
    <a class="w-cta w-button" href={`mailto:info@dymora.eu?subject=${subject}`}>Richiedi una consulenza<span class="visually-hidden"> su {f.label}</span></a>
  </div>
  {main ? (
    <figure class="spot__media">
      <img class="spot__main" src={main.src} alt={main.alt} width={main.width} height={main.height} loading="lazy" decoding="async" />
      {extra.map((m, i) => <img class={`spot__float spot__float--${i + 1}`} src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" />)}
      <figcaption class="w-note w-muted">Immagini dimostrative.</figcaption>
    </figure>
  ) : f.house && (
    <figure class="spot__media spot__media--house">
      <HouseHero id={`spot-house-${slug}`} variant={tone === 'paper' ? 'light' : 'dark'} layers={f.house.layers} alt={f.house.alt} buttons={f.house.buttons} />
      <figcaption class="w-note w-muted">Immagini dimostrative.</figcaption>
    </figure>
  )}
</Band>
