---
// First section after the opening, on carbon: the cover's promise ("I tuoi spazi. In una sola
// app.", `cover.eyebrow.web`, `cover.title.web`, `cover.line`) shown on the app (the energy screen on a computer and a
// phone, rising into place while the page scrolls). `#app` is the anchor of the opening's cue.
// The slot, after the app, takes "Per chi è Dymora" (Segments.astro).
// The functions' scroll story that followed was removed on 2026-11-26 (owner decision; it is on
// the branch archivio/funzioni).
import Headline from '../Headline.astro';
---
<section class="band band--ink" aria-labelledby="app-title">
  <div class="band__inner story__inner">
    <div class="app" id="app">
      <div class="app__glow" aria-hidden="true"></div>
      <div class="app__head" data-reveal>
        <Headline id="app-title" size="l" text="I tuoi **spazi**. In una sola app." />
        <p class="w-lead w-muted">Luci, clima, tapparelle, serrature, allarme, telecamere, consumi e irrigazione, con progettazione, installazione, configurazione e assistenza di Dymora.</p>
      </div>
      <figure class="app__devices">
        <div class="app__laptop">
          <div class="app__screen"><img src="/assets/images/app/energy-current-page-wide-light.webp" alt="I consumi della casa nell'app Dymora sul computer: la casa con la potenza di ogni apparecchio, il consumo della settimana dalla rete e dal fotovoltaico" width="1600" height="930" loading="lazy" decoding="async" /></div>
          <div class="app__base" aria-hidden="true"></div>
        </div>
        <div class="app__phone">
          <div class="app__screen"><img src="/assets/images/app/energy-current-page-phone-light.webp" alt="I consumi della casa nell'app Dymora sul telefono" width="660" height="1290" loading="lazy" decoding="async" /></div>
        </div>
      </figure>
    </div>
    <slot />
  </div>
</section>
