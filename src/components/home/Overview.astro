---
// Brochure page 2 (`overview`): the house with eight tags and their leaders on panna,
// then the title and the eight functions on carbon. On the web the functions switch on
// one after another and each plays its part of the house (sprites from dymora-app art/house).
// Web layout: one carbon section, the house standing bare on it,
// copy and functions beside it on wide screens (`.overview__inner`, home.css).
// Leader points: brochure decision.html, page `overview`, normalised on the house
// (x − 2) / 206, (y − 31) / 139 mm. They point at the HouseElements of the app's Home legend.
import Band from '../Band.astro';
import Headline from '../Headline.astro';
import Sprite from '../Sprite.astro';

// The tags light up one at a time and each part of the house plays in (overview.js):
// `on` tokens join data-layers, `off` tokens leave it (their clip reversed).
// The house starts closed: shutters down, awning in, everything off.
const items = [
  { id: 'clima', label: 'Clima', row: 'top', on: 'climate_hp_fan_start_off>climate_hp_fan_run_off climate_hp_air_off climate_hp_led_off climate_ac_fan_start_off>climate_ac_fan_run_off climate_ac_air_off climate_ac_led_off' },
  { id: 'allarme', label: 'Allarme', row: 'top', on: 'alarm_armed_off' },
  { id: 'consumi', label: 'Consumi', row: 'top', on: 'grid_flow_off grid_light_off' },
  { id: 'luci', label: 'Luci', row: 'top', on: 'lit_off' },
  { id: 'irrigazione', label: 'Irrigazione', row: 'bot', on: 'irrigation_on_off>irrigation_run_off' },
  { id: 'tapparelle', label: 'Tapparelle', row: 'bot', on: 'awning_out_off!', off: 'shutters_down_off!' },
  { id: 'telecamere', label: 'Telecamere', row: 'bot', on: 'camera_left_on_off>camera_left_scan_off~24 camera_right_on_off>camera_right_scan_off~-24' },
  { id: 'serrature', label: 'Serrature', row: 'bot', on: 'door_led_off!' },
];
// Order of the story: the shutters open and the awning comes out, then the lights.
const sequence = ['tapparelle', 'luci', 'clima', 'irrigazione', 'consumi', 'serrature', 'allarme', 'telecamere'];
// The app's draw order (art/house/brief.md): light, then curtains, shutters, awning, the rest.
const order = 'lit_off shutters_down_off shutters_through_off awning_shade_off balustrade_off awning_out_off grid_light_off grid_flow_off irrigation_on_off irrigation_run_off camera_left_on_off camera_left_scan_off camera_right_on_off camera_right_scan_off climate_hp_air_off climate_hp_fan_start_off climate_hp_fan_run_off climate_hp_led_off climate_ac_air_off climate_ac_fan_start_off climate_ac_fan_run_off climate_ac_led_off alarm_armed_off door_led_off';
const rest = 'balustrade_off shutters_down_off!';
const functions = ['Luci', 'Allarme', 'Clima', 'Telecamere', 'Tapparelle', 'Consumi', 'Serrature', 'Irrigazione'];
---
<Band tone="ink" id="panoramica" class="overview" labelledby="overview-title" innerClass="overview__inner">
  <div class="overview__copy">
    <div data-reveal>
      <Headline id="overview-title" size="l" text="**Controlla** la tua casa sotto ogni aspetto." />
    </div>
    <p class="w-lead" data-reveal data-reveal-step="1">Con progettazione, installazione, configurazione e assistenza di Dymora.</p>
    <p class="w-note w-muted" data-reveal data-reveal-step="2">Funzioni e rilevamenti dipendono dai dispositivi e dalla configurazione scelta.</p>
  </div>
  <div class="ov-panel" data-reveal="panel" data-reveal-step="1">
    <div class="ov-stage" data-ov-sequence={sequence.join(' ')} data-ov-rest={rest}>
      <div class="ov-house">
        <Sprite id="ov-house" name="house" variant="dark" layers={rest} order={order} alt="La casa con luci, clima, tapparelle, serrature, allarme, telecamere, consumi e irrigazione gestiti da Dymora" />
        <div class="ov-items" aria-hidden="true">
          {items.map((item) => (
            <div class:list={['ov-item', `ov-item--${item.row}`, `ov-i--${item.id}`]} data-ov-item={item.id} data-ov-on={item.on} data-ov-off={item.off}>
              <span class="ov-lead"></span>
              <span class="tag ov-tag">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <ul class="overview-list" data-reveal data-reveal-step="3">
    {functions.map((f) => <li><a class="w-label eyebrow" href={`#${f.toLowerCase()}`}>{f}</a></li>)}
  </ul>
</Band>
<script is:inline src="/assets/js/overview.js" defer></script>
