---
// "Il servizio" and "Come si parte" in one panna chapter (2026-11-25): the five moments of the
// service, Ti ascoltiamo → Progettiamo → Installiamo → Configuriamo → Ti assistiamo.
//
// The steps are short, so the chapter plays on its own instead of asking for a scroll (owner
// decision, 2026-11-26): a carbon stage on the left, the five steps on the right; while the
// section shows, the steps take turns and each one plays its scene on the stage (service.js,
// service.css). The visitor can pick a step (click on it, or the buttons of the rail) and pause
// the loop with the button on the stage (WCAG 2.2.2). Scenes are drawn in HTML on the site's
// assets: the consultation form with the functions chosen in it, the flat marked on its building
// and then its plan with the same functions beside it, the devices joining the hub, the switches turning on in the app, a light that
// stops answering and comes back after a mail to support. Every scene is decorative (aria-hidden): the steps say the
// same in text.
// Without JavaScript the first scene rests and the steps read as plain text; with reduced motion
// nothing plays on its own: the rail and the steps still change the scene, without movement.
//
// Copy: `service` (title from the brochure draft "Pensiamo a tutto noi.", line as approved) and
// the steps built from `start.step1–4`, `service.principles` and the claims Servizio-4, -5, -10.
// Anchors kept for the header and the footer: #servizio, #come-si-parte.
import Headline from '../Headline.astro';
import Sprite from '../Sprite.astro';

const steps = [
  {
    id: 'ascolto',
    nav: 'Ascolto',
    title: 'Ti **ascoltiamo**.',
    line: 'Ci dici cosa vuoi tenere sotto controllo: anche solo alcuni apparecchi. Puoi partire da una sola funzione, per esempio i consumi.',
  },
  {
    id: 'progetto',
    nav: 'Progetto',
    title: '**Progettiamo** su misura.',
    line: 'Scegliamo insieme ciò che serve davvero. Se hai già delle telecamere, valutiamo se sono compatibili.',
  },
  {
    id: 'posa',
    nav: 'Installazione',
    title: '**Installiamo** i dispositivi.',
    line: 'Posiamo i dispositivi che abbiamo scelto insieme. Non devi saperne di tecnologia: ce ne occupiamo noi.',
  },
  {
    id: 'app',
    nav: 'Configurazione',
    title: "**Configuriamo** l'app.",
    line: "Prepariamo l'app con le funzioni che hai scelto: una sola app per la tua casa, invece di una per ogni marca.",
  },
  {
    id: 'assistenza',
    nav: 'Assistenza',
    title: 'Ti **assistiamo**, anche dopo.',
    line: "Il lavoro non finisce con l'installazione: l'assistenza resta. Se hai un problema, scrivi a support@dymora.eu.",
  },
];

// Scene 1: the consultation as a short form, three questions answered one after another (`on`
// marks the answers picked). The functions chosen here are the ones scene 2 pins on the house.
const form = [
  { q: 'Che casa hai?', opts: [{ t: 'Appartamento', on: true }, { t: 'Villa' }, { t: 'Ufficio' }] },
  {
    q: 'Cosa vuoi tenere **sotto controllo**?',
    opts: [{ t: 'Luci', on: true }, { t: 'Clima', on: true }, { t: 'Consumi', on: true }, { t: 'Serrature', on: true }, { t: 'Allarme' }],
  },
  { q: 'Hai già dei dispositivi?', opts: [{ t: 'Telecamere', on: true }, { t: 'Termostato' }, { t: 'Nessuno' }] },
];
// The question's key phrase, between ** **, in orange.
const parts = (q: string) => q.split('**').map((t, i) => ({ t, accent: i % 2 === 1 }));
// Scene 2: the flat's plan, the functions chosen in scene 1 beside it, each with a line to its
// place (the camera outside, on the entrance). `y` is the badge's top and `to` the line's end, in
// stage units (the stage is 100 × 84.75; the plan sits at 20, 18 at 0.6 units per plan unit).
const fns = [
  { t: 'Consumi', ic: 'consumi', side: 'l', y: 26, to: [26.6, 37.8] },
  { t: 'Serratura', ic: 'serratura', side: 'l', y: 44, to: [30.2, 54] },
  { t: 'Telecamera', ic: 'camera', side: 'l', y: 62, to: [26, 57] },
  { t: 'Clima', ic: 'clima', side: 'r', y: 24, to: [56, 31.2] },
  { t: 'Luci', ic: 'luci', side: 'r', y: 44, to: [56, 44.4] },
];
const fnLine = (f: (typeof fns)[number]) => `M${f.side === 'l' ? 19 : 81} ${f.y + 2.5} L${f.to[0]} ${f.to[1]}`;
const rooms = ['Cucina', 'Bagno', 'Soggiorno', 'Camera', 'Terrazzo'];
// Scene 3: the five devices chosen in scenes 1 and 2 around the hub, linked in this order. `at` is
// the device's centre in stage units (100 × 84.75); `gap` keeps its wire clear of its name.
const hubAt = [50, 45];
const devices = [
  { t: 'Luci', src: '/assets/images/devices/luci.webp', w: 428, h: 360, at: [50, 12.5], gap: 13 },
  { t: 'Clima', src: '/assets/images/devices/clima.webp', w: 285, h: 360, at: [84, 34], gap: 8 },
  { t: 'Consumi', src: '/assets/images/devices/consumi.webp', w: 183, h: 256, at: [72, 71], gap: 8 },
  { t: 'Serratura', src: '/assets/images/devices/serrature.webp', w: 186, h: 360, at: [28, 71], gap: 8 },
  { t: 'Telecamera', src: '/assets/images/devices/telecamere.webp', w: 292, h: 402, at: [16, 34], gap: 8 },
];
// The wire from the hub to a device, stopped short of the hub and of the device.
const wire = (d: (typeof devices)[number]) => {
  const dx = d.at[0] - hubAt[0], dy = d.at[1] - hubAt[1], l = Math.hypot(dx, dy);
  const f = (n: number) => n.toFixed(2);
  return `M${f(hubAt[0] + (dx * 12) / l)} ${f(hubAt[1] + (dy * 12) / l)} L${f(d.at[0] - (dx * d.gap) / l)} ${f(d.at[1] - (dy * d.gap) / l)}`;
};
// Scene 4: the app's switches.
const toggles = ['Luci', 'Clima', 'Consumi', 'Serrature'];
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="band band--paper svc" id="servizio" aria-labelledby="service-title">
  <div class="band__inner svc__inner">
    <div class="svc__story">
    <div class="svc__head">
      <p class="w-label eyebrow">Il servizio</p>
      <Headline id="service-title" size="l" text="Pensiamo a tutto **noi**." />
    </div>
    <p class="w-lead w-muted svc__lead" data-reveal>Dymora non è un'app da scaricare e arrangiarsi: ci occupiamo di progettazione, installazione, configurazione e assistenza.</p>

    <div class="svc__body" id="come-si-parte">
      <div class="svc__show">
        <div class="svc__frame">
          <div class="svc__stage" data-svc-stage aria-hidden="true">
            <div class="svc__glow"></div>

            <!-- 1 · Ascolto: the consultation as a form, its answers picked one after another -->
            <div class="svc-scene svc-scene--listen is-active" data-svc-scene="0">
              <div class="sc-form">
                <div class="sc-form__top">
                  <span class="w-label">Consulenza</span>
                  <span class="sc-form__bar"><i></i></span>
                </div>
                {form.map((f) => (
                  <div class="sc-ask">
                    <p class="sc-ask__q">{parts(f.q).map((p) => (p.accent ? <span>{p.t}</span> : p.t))}</p>
                    <ul class="sc-opts">
                      {f.opts.map((o) => <li class:list={{ 'sc-opt--on': o.on }}>{o.t}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </div>

            <!-- 2 · Progetto: the flat marked on its building, a zoom into it, its plan drawn in and
                 the functions beside it, each with a line to its place -->
            <svg class="sc-icons" width="0" height="0">
              <symbol id="sc-ic-luci" viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z" /></symbol>
              <symbol id="sc-ic-clima" viewBox="0 0 24 24"><path d="M14 14.8V5a2 2 0 0 0-4 0v9.8a4 4 0 1 0 4 0zM12 11v6" /></symbol>
              <symbol id="sc-ic-consumi" viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></symbol>
              <symbol id="sc-ic-serratura" viewBox="0 0 24 24"><path d="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2zM8 11V7a4 4 0 0 1 8 0v4" /></symbol>
              <symbol id="sc-ic-camera" viewBox="0 0 24 24"><path d="M4 7h10a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM15 10.5l6-3.5v10l-6-3.5" /></symbol>
              <symbol id="sc-ic-casa" viewBox="0 0 24 24"><path d="M3 11 12 4l9 7M5 9.5V20h14V9.5M10 20v-5h4v5" /></symbol>
            </svg>
            <div class="svc-scene svc-scene--plan" data-svc-scene="1">
              <div class="sc-grid"></div>
              <div class="sc-bld">
                <Sprite name="apartment_building" variant="light" alt="" class="sc-bld__sprite" preload="lights_on_idle!" />
                <span class="sc-tag sc-bld__mark"><i><svg viewBox="0 0 24 24"><use href="#sc-ic-casa" /></svg></i><b>Il tuo appartamento</b></span>
              </div>
              <div class="sc-flat">
                <svg class="sc-flat__svg" viewBox="0 0 100 70">
                  <g class="sc-flat__furn">
                    <rect x="9" y="11" width="18" height="3.4" /><rect x="9" y="11" width="3.4" height="14" /><rect x="16" y="19.5" width="10" height="4" rx=".6" />
                    <rect x="36" y="12" width="5.5" height="10" rx="1.2" /><rect x="45" y="12" width="3.2" height="4.4" rx="1.4" /><rect x="44.5" y="18.5" width="4" height="3" rx=".6" />
                    <rect x="22" y="50" width="20" height="5.5" rx="1" /><rect x="22" y="53.7" width="20" height="1.8" rx=".6" /><rect x="26.5" y="42" width="11" height="5" rx=".8" />
                    <rect x="54" y="46" width="12" height="7" rx="1" /><circle cx="56.5" cy="44.6" r=".9" /><circle cx="63.5" cy="44.6" r=".9" /><circle cx="56.5" cy="54.4" r=".9" /><circle cx="63.5" cy="54.4" r=".9" />
                    <rect x="70" y="17" width="16" height="19" rx="1" /><rect x="71.5" y="18.2" width="5.6" height="3" rx=".8" /><rect x="78.9" y="18.2" width="5.6" height="3" rx=".8" /><rect x="52" y="12" width="3.4" height="15" />
                    <circle cx="80" cy="52" r="2" /><circle cx="86.5" cy="49" r="2" /><circle cx="83.2" cy="50.4" r="1.4" />
                  </g>
                  <path class="sc-flat__rail" d="M72 60 H92 V40" />
                  <path class="sc-flat__wall sc-flat__wall--out" pathLength="1" d="M8 10 H92 V40 H72 V60 H8 Z" />
                  <path class="sc-flat__wall sc-flat__wall--in" pathLength="1" d="M34 10 V30 H50 M50 10 V40 H72" />
                  <g class="sc-flat__open">
                    <rect x="14" y="9" width="10" height="2" /><rect x="40" y="9" width="4" height="2" /><rect x="76" y="9" width="10" height="2" />
                    <rect x="91" y="18" width="2" height="12" /><rect x="36" y="59" width="16" height="2" />
                    <rect x="14" y="59" width="6" height="2" /><rect x="71" y="44" width="2" height="8" />
                    <rect x="44" y="29.4" width="5" height="1.2" /><rect x="54" y="39.4" width="5" height="1.2" />
                  </g>
                  <path class="sc-flat__glass" d="M14 9.6 H24 M14 10.4 H24 M40 9.6 H44 M40 10.4 H44 M76 9.6 H86 M76 10.4 H86 M91.6 18 V30 M92.4 18 V30 M36 59.6 H52 M36 60.4 H52" />
                  <path class="sc-flat__door" d="M20 60 V54 A6 6 0 0 0 14 60 M72 44 H78 A8 8 0 0 1 72 52 M44 30 V25 A5 5 0 0 1 49 30 M59 40 V35 A5 5 0 0 0 54 40" />
                </svg>
                {rooms.map((r, i) => <span class:list={['sc-room', `sc-room--${i + 1}`]}>{r}</span>)}
              </div>
              <svg class="sc-links" viewBox="0 0 100 84.75">
                {fns.map((f) => <path pathLength="1" d={fnLine(f)} />)}
                {fns.map((f) => <circle cx={f.to[0]} cy={f.to[1]} r=".8" />)}
              </svg>
              {fns.map((f, i) => (
                <span class:list={['sc-tag', 'sc-fn', `sc-fn--${f.side}`, `sc-fn--${i + 1}`]}><i><svg viewBox="0 0 24 24"><use href={`#sc-ic-${f.ic}`} /></svg></i><b>{f.t}</b></span>
              ))}
              <p class="sc-stamp w-label"><span>Progetto</span> 5 funzioni</p>
            </div>

            <!-- 3 · Installazione: the devices wait dimmed around the hub; a signal runs to each in
                 turn, its wire turns orange and the device lights up, "Collegato" -->
            <div class="svc-scene svc-scene--install" data-svc-scene="2">
              <svg class="sc-wires" viewBox="0 0 100 84.75">
                {devices.map((d) => <path class="sc-wire" d={wire(d)} />)}
                {devices.map((d) => <path class="sc-wire__on" pathLength="1" d={wire(d)} />)}
                {devices.map((d) => <path class="sc-wire__pulse" pathLength="1" d={wire(d)} />)}
              </svg>
              <span class="sc-hub"><img src="/assets/images/hub.webp" alt="" width="1200" height="987" loading="lazy" decoding="async" /></span>
              {devices.map((d, i) => (
                <span class:list={['sc-dev', `sc-dev--${i + 1}`]}>
                  <img src={d.src} alt="" width={d.w} height={d.h} loading="lazy" decoding="async" />
                  <span class="sc-dev__name">{d.t}<small>Collegato</small></span>
                </span>
              ))}
              <p class="sc-count w-label"><span>Collegati</span> <b>{[0, 1, 2, 3, 4, 5].map((n) => <i>{n}</i>)}</b>/5</p>
            </div>

            <!-- 4 · Configurazione: the app, its switches turning on one by one -->
            <div class="svc-scene svc-scene--config" data-svc-scene="3">
              <div class="sc-phone">
                <div class="sc-app">
                  <img class="sc-app__mark" src="/assets/images/logo-mark-ink.svg" alt="" width="517" height="376" loading="lazy" />
                  <p class="sc-app__title">Le tue <span>funzioni</span>.</p>
                  <ul class="sc-app__list">
                    {toggles.map((t) => <li><span class="sc-app__name">{t}</span><span class="sc-switch"></span></li>)}
                  </ul>
                  <span class="sc-app__bar"><i></i></span>
                  <p class="sc-app__done">Pronta</p>
                </div>
              </div>
            </div>

            <!-- 5 · Assistenza: a light stops answering, a mail to support, the light answers again -->
            <div class="svc-scene svc-scene--care" data-svc-scene="4">
              <div class="sc-care">
                <div class="sc-card sc-card--dev">
                  <img src="/assets/images/devices/luci.webp" alt="" width="428" height="360" loading="lazy" decoding="async" />
                  <span class="sc-card__name">Luce soggiorno<small class="sc-st sc-st--ko">Non risponde</small><small class="sc-st sc-st--ok">Collegata</small></span>
                </div>
                <div class="sc-card sc-card--mail">
                  <span class="w-label sc-card__to">A</span>
                  <span class="sc-card__addr">support@dymora.eu</span>
                  <span class="sc-card__sent w-label">Inviata</span>
                </div>
              </div>
            </div>
          </div>

          <button class="svc__pause" type="button" data-svc-pause aria-pressed="false" aria-label="Metti in pausa l'animazione del servizio" hidden>
            <span class="svc__pause-icon" aria-hidden="true"></span>
          </button>
        </div>

        <div class="svc__nav" data-svc-nav hidden>
          <span class="svc__rail" aria-hidden="true"><span class="svc__fill"></span></span>
          <ol>
            {steps.map((s, i) => (
              <li class:list={{ 'is-active': i === 0 }} data-svc-node={i}>
                <button type="button" aria-label={`Passo ${i + 1} di 5: ${s.nav}`}><span class="svc__node" aria-hidden="true"></span><span class="w-label" aria-hidden="true">{s.nav}</span></button>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <ol class="svc__steps">
        {steps.map((s, i) => (
          <li class="svc__step" data-svc-step={i}>
            <p class="w-label svc__num"><span>{pad(i)}</span> / 05</p>
            <Headline as="h3" size="m" text={s.title} />
            <p class="w-body w-muted">{s.line}</p>
          </li>
        ))}
      </ol>
    </div>
    </div>
  </div>
</section>
<script is:inline src="/assets/js/service.js" defer></script>
