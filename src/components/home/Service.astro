---
// The service on panna, in the trust pattern of the premium sites: `service` (eyebrow, title,
// line), the site's numbers (`site.stats`, as on the current site, never widened) in large Doto,
// then `service.principles` as three numbered cards.
import Band from '../Band.astro';
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';

const principles = [
  ['Semplice.', "Una sola app per le funzioni della tua casa, invece di una per ogni marca. Ti aiutiamo a scegliere ciò che serve davvero."],
  ['Chiaro.', "L'app mostra ciò che i dispositivi comunicano. Se una luce non risponde te lo dice, e uno storico stimato non diventa una misura."],
  ['Seguito.', "Il lavoro non finisce con l'installazione: l'assistenza resta anche dopo."],
];
const stats = [['1', 'Sola app'], ['6+', 'Sistemi unificati'], ['24/7', 'Monitoraggio'], ['0', 'Vendor lock-in']];
---
<Band tone="paper" id="servizio" class="service" labelledby="service-title" innerClass="service__inner">
  <div class="service__head">
    <Eyebrow text="Il servizio" />
    <Headline id="service-title" size="l" text="Progettiamo, installiamo, configuriamo e ti **assistiamo**." />
    <p class="w-lead w-muted">Dymora non è un'app da scaricare e arrangiarsi: ci occupiamo di progettazione, installazione, configurazione e assistenza.</p>
  </div>
  <ul class="stat-row">
    {stats.map(([n, l]) => <li><span class="w-num-l">{n}</span><span class="w-label w-muted">{l}</span></li>)}
  </ul>
  <div class="service__trust">
    <Headline id="trust-title" as="h3" size="m" text="Su cosa puoi **contare**." />
    <ol class="principle-list">
      {principles.map(([t, l], i) => <li><span class="w-label principle__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h4 class="h-s">{t}</h4><p class="w-body w-muted">{l}</p></li>)}
    </ol>
  </div>
</Band>
