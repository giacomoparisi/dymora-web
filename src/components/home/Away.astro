---
// Brochure page `opening` (`opening.problem`, `opening.change`): the question on carbon with
// one camera event, the answer on panna with the video-surveillance page and two more events.
// Camera frames are generated images of an invented house (dymora-app store-screenshots/CAMERAS.md);
// the detection boxes are drawn here, as the brochure composes them, never baked in.
import Headline from '../Headline.astro';

const cams = {
  person: { src: '/assets/images/cam-person.webp', label: 'Persona', where: 'Ingresso' },
  car: { src: '/assets/images/cam-car.webp', label: 'Auto', where: 'Ingresso' },
  animal: { src: '/assets/images/cam-animal.webp', label: 'Animale', where: 'Ingresso' },
};
---
<section class="away" id="telecamere" aria-labelledby="away-title">
  <div class="band band--ink">
    <div class="band__inner away__top">
      <div class="away__copy">
        <Headline id="away-title" size="xl" text="Sai cosa succede quando **non ci sei**?" />
        <ul class="w-lead away__questions">
          <li>Hai chiuso la porta?</li>
          <li>Hai inserito l'allarme?</li>
          <li>Hai lasciato una luce accesa?</li>
        </ul>
      </div>
      <figure class="cam cam--person">
        <img src={cams.person.src} alt="Telecamera dell'ingresso: una persona sul vialetto" width="960" height="542" loading="lazy" />
        <figcaption class="w-label cam__where">{cams.person.where}</figcaption>
        <span class="cam__box" aria-hidden="true"><span class="tag tag--hit">{cams.person.label}</span></span>
      </figure>
    </div>
  </div>
  <div class="band band--ink">
    <div class="band__inner away__bottom">
      <div class="away__copy">
        <Headline size="l" text="Con Dymora l'edificio è sempre **con te**." />
        <p class="w-lead w-muted">Apri l'app dovunque ti trovi e gestisci il tuo edificio quando ne hai bisogno.</p>
        <a class="w-cta w-button" href="/videosorveglianza/">Videosorveglianza</a>
      </div>
      <div class="away__media">
        <div class="away__cams">
          <figure class="cam cam--car">
            <img src={cams.car.src} alt="Telecamera dell'ingresso: un'auto al cancello" width="960" height="542" loading="lazy" />
            <span class="cam__box" aria-hidden="true"><span class="tag tag--hit">{cams.car.label}</span></span>
          </figure>
          <figure class="cam cam--animal">
            <img src={cams.animal.src} alt="Telecamera dell'ingresso: un animale sul prato" width="960" height="542" loading="lazy" />
            <span class="cam__box" aria-hidden="true"><span class="tag tag--hit">{cams.animal.label}</span></span>
          </figure>
        </div>
        <div class="device device--phone device--phone-tall away__phone">
          <img src="/assets/images/video-surveillance-house-no-frames-compact-dark.webp" alt="La pagina Videosorveglianza dell'app Dymora" width="1644" height="3564" loading="lazy" />
        </div>
      </div>
      <p class="w-note w-muted away__note">Immagini dimostrative.</p>
    </div>
  </div>
</section>
