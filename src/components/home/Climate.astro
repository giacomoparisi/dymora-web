---
// Brochure page `climate` (`climate`, `climate.save`), all carbon, plus the site's points of
// `feature.climate`: the bathroom thermostat and the living-room chart are the app's own pieces;
// the four devices are animated scenes from dymora-app art/.
import Band from '../Band.astro';
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';
import DeviceTile from '../DeviceTile.astro';

const devices = [
  { id: 'cl-ac', sprite: 'air_conditioner', layers: 'open_unit>air_unit', name: 'Climatizzatore soggiorno' },
  { id: 'cl-ir', sprite: 'ir_remote', layers: '', name: 'Condizionatore cucina' },
  { id: 'cl-valve', sprite: 'thermostatic_valve', layers: 'power_idle>heat_idle', name: 'Valvola camera' },
  { id: 'cl-thermo', sprite: 'thermostat', layers: '', name: 'Termostato bagno' },
];
---
<Band tone="ink" id="clima" class="climate" labelledby="climate-title" innerClass="climate__inner">
  <div class="climate__copy">
    <Eyebrow text="Clima" />
    <Headline id="climate-title" size="l" text="Il **clima** di casa, da dove vuoi." />
    <p class="w-lead w-muted">Gestisci il riscaldamento anche quando non sei in casa.</p>
    <ul class="w-body points">
      <li>Vedi temperatura e umidità dai sensori disponibili.</li>
      <li>Imposti la temperatura dei climatizzatori compatibili.</li>
      <li>Cambi modalità, ventola e oscillazione.</li>
    </ul>
  </div>
  <figure class="climate__thermostat">
    <img src="/assets/images/pieces/climate-thermostat.webp" alt="Il termostato del bagno nell'app Dymora, con la temperatura impostata" width="800" height="1088" loading="lazy" />
  </figure>
  <figure class="climate__chart">
    <img src="/assets/images/pieces/climate-chart.webp" alt="Temperatura e umidità del soggiorno nelle ultime 24 ore, nell'app Dymora" width="900" height="758" loading="lazy" />
  </figure>
  <div class="climate__save">
    <Headline as="h3" size="s" text="Scaldi e rinfreschi solo **dove serve**." />
    <p class="w-body w-muted">La casa si adatta per evitare sprechi.</p>
  </div>
  <div class="climate__devices">
    <Eyebrow text="Ogni dispositivo" rule />
    <div class="tile-row tile-row--4">
      {devices.map((d) => <DeviceTile id={d.id} sprite={d.sprite} variant="dark" layers={d.layers} play name={d.name} />)}
    </div>
    <p class="w-note w-muted">Immagini dimostrative.</p>
  </div>
</Band>
