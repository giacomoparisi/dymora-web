---
// Brochure page `irrigation` (`feature.irrigation`): on carbon the garden's house with the sprinklers on,
// on panna the garden valve running, the morning programme card and the four lawns (brochure pieces).
// The tap is the animated scene from dymora-app art/water-tap. No "programmi" in the copy.
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';
import DeviceTile from '../DeviceTile.astro';

const lawns = [
  { src: 'irrigation-lawn-english', alt: 'Prato inglese, terreno secco' },
  { src: 'irrigation-lawn-roses', alt: 'Prato del roseto, umidità nella norma' },
  { src: 'irrigation-lawn-terrace', alt: 'Prato della piscina, terreno bagnato' },
  { src: 'irrigation-lawn-lemon', alt: 'Prato del limone, umidità nella norma' },
];
---
<section class="irrigation" id="irrigazione" aria-labelledby="irrigation-title">
  <div class="band band--ink">
    <div class="band__inner irrigation__top">
      <div class="irrigation__copy">
        <Eyebrow text="Irrigazione" />
        <Headline id="irrigation-title" size="l" text="Innaffia il tuo **giardino** in automatico." />
        <p class="w-lead w-muted">Configuriamo noi pompe e valvole per farle partire da sole. Dall'app vedi se il terreno ha l'umidità adatta alle tue piante.</p>
        <ul class="w-body points">
          <li>Vedi umidità del terreno, temperatura e batteria, quando la sonda le fornisce.</li>
          <li>Avvii e fermi pompe o valvole.</li>
          <li>Avvii con una durata, se il dispositivo la gestisce.</li>
        </ul>
      </div>
      <figure class="irrigation__house">
        <img src="/assets/images/pieces/irrigation-house.webp" alt="Il giardino nell'app Dymora con gli irrigatori accesi" width="1200" height="982" loading="lazy" />
      </figure>
    </div>
  </div>
  <div class="band band--ink">
    <div class="band__inner irrigation__bottom">
      <figure class="irrigation__valve">
        <img src="/assets/images/pieces/irrigation-valve.webp" alt="La valvola del giardino in funzione sulle sue piante" width="1000" height="667" loading="lazy" />
      </figure>
      <div class="irrigation__side">
        <DeviceTile id="ir-tap" sprite="water_tap" name="Rubinetto del giardino" toggle={{ layer: 'turn_tap>pour_tap>flow_tap', on: 'Aperto', off: 'Chiuso' }} />
        <img class="irrigation__programme" src="/assets/images/pieces/irrigation-programme.webp" alt="Un'irrigazione del mattino nell'app Dymora" width="900" height="737" loading="lazy" />
      </div>
      <ul class="irrigation__lawns">
        {lawns.map((l) => <li><img src={`/assets/images/pieces/${l.src}.webp`} alt={l.alt} width="400" height="400" loading="lazy" /></li>)}
      </ul>
      <p class="w-note w-muted">Immagini dimostrative.</p>
    </div>
  </div>
</section>
