---
// "Come si parte" (`start`, `start.step1–4`) on panna: four steps on a line that fills in orange
// while the section scrolls through the window (steps.css, scroll-driven where supported; full
// without it). Vertical on phones.
import Band from '../Band.astro';
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';

const steps = [
  ['Ci sentiamo.', 'Ci dici cosa vuoi tenere sotto controllo: anche solo alcuni apparecchi.'],
  ['Progettiamo la tua installazione.', 'Scegliamo insieme cosa serve. Se hai già delle telecamere, valutiamo se sono compatibili.'],
  ['Installiamo e configuriamo.', "Posiamo i dispositivi e prepariamo l'app con le funzioni che hai scelto."],
  ["Usi l'app, con la nostra assistenza.", 'Se hai un problema, scrivi a support@dymora.eu.'],
];
---
<Band tone="paper" id="come-si-parte" class="start" labelledby="start-title" innerClass="start__inner">
  <div class="start__head">
    <Eyebrow text="Come si parte" />
    <Headline id="start-title" size="l" text="Si parte da una **chiamata**." />
  </div>
  <div class="start__steps">
  <div class="step-list__track" aria-hidden="true"><span></span></div>
  <ol class="step-list">
    {steps.map(([t, l], i) => <li><span class="step-list__dot w-label" aria-hidden="true">{i + 1}</span><h3 class="h-s">{t}</h3><p class="w-body w-muted">{l}</p></li>)}
  </ol>
  </div>
</Band>
