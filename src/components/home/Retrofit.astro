---
// Brochure page `retrofit` (2026-11-22/23): the period house and the modern one, a badge
// over each, a block under each and the closing line.
// Web layout: one carbon section; each option keeps its picture and its block together.
// Phone: title, options, closing line. Wide (>=1100px): title and closing line on the
// left, the two options side by side on the right (`.retrofit__inner`, home.css).
import Headline from '../Headline.astro';

const options = [
  {
    tag: 'Senza ristrutturazione',
    src: '/assets/images/edificio-epoca.webp',
    alt: "Un edificio d'epoca con l'impianto esistente",
    title: '**Pronta in un giorno**, senza cantiere.',
    body: 'Soluzioni poco invasive: niente opere murarie e nessun impianto elettrico da rifare.',
  },
  {
    tag: 'Con ristrutturazione',
    src: '/assets/images/edificio-moderna.webp',
    alt: 'Una casa moderna con luci, tenda e irrigazione accese',
    title: '**Pianificata con te**, in ogni dettaglio.',
    body: 'Impianto progettato su misura durante la fase di ristrutturazione sulle tue esigenze.',
  },
];
---
<section class="retrofit band band--ink" id="ristrutturazioni" aria-labelledby="retrofit-title">
  <div class="band__inner retrofit__inner">
    <div class="retrofit__title">
      <Headline id="retrofit-title" size="l" text="**Dymora si adatta** al tuo edificio." />
    </div>
    <ul class="retrofit__options">
      {options.map((o) => (
        <li>
          <figure>
            <span class="tag tag--accent">{o.tag}</span>
            <img src={o.src} alt={o.alt} width="1600" height="1080" loading="lazy" />
          </figure>
          <Headline as="h3" size="s" text={o.title} />
          <p class="w-body w-muted">{o.body}</p>
        </li>
      ))}
    </ul>
    <Headline as="p" size="m" class="retrofit__close" text="Non c'è una soluzione unica. **C'è la tua.**" />
  </div>
</section>
