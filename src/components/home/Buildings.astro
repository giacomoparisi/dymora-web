---
// Brochure pages 3–4 (`multi`, `retrofit`) as one compact chapter on carbon, in the language of
// the sections above it: no panels, the product floats on the carbon with the orange glow, and
// the story plays by itself (no controls to click).
//
// Multi: the property's render beside a phone with the app's installation picker (drawn in HTML,
// a demonstrative copy of the installation-selection screen). When the chapter comes on screen a
// tap lands on the next row, the row lights up and the render changes: Casa → Montagna → Ufficio
// → Casa, once, then it rests. A thin rail (not a control) shows the progress.
// Retrofit: one render where a line sweeps from the period building ("Senza ristrutturazione")
// to the modern house ("Con ristrutturazione"), once; the matching option's text lights up.
// buildings.js plays each one once every time it comes back on screen.
// Without JavaScript or with reduced motion: Casa selected, the retrofit split half and half
// with both texts lit.
// Anchors kept for the header and the footer: #edifici, #ristrutturazioni.
import Headline from '../Headline.astro';
import { multi, retrofit } from '../../data/intro';
---
<section class="band band--ink bld" id="edifici" aria-labelledby="multi-title">
  <div class="band__inner bld__inner">
    <div class="bld__multi" data-multi>
      <div class="bld__head" data-reveal>
        <p class="w-label eyebrow">Più edifici</p>
        <Headline id="multi-title" size="l" text={multi.title} />
        <p class="w-lead w-muted">{multi.line}</p>
      </div>

      <figure class="bld__stage" data-reveal="panel" data-reveal-step="1">
        <div class="bld__glow" aria-hidden="true"></div>
        <div class="bld__props" aria-hidden="true">
          {multi.buildings.map((b, i) => (
            <div class:list={['bld__prop', { 'is-active': i === 0 }]} data-multi-item={b.id}>
              <img src={b.src} alt="" width={b.w} height={b.h} loading="lazy" decoding="async" />
              <span class="w-label bld__name">{b.app}</span>
            </div>
          ))}
        </div>
        <div class="bld__phone" aria-hidden="true">
          <div class="bld__screen">
            <div class="pk">
              <div class="pk__brand">
                <img class="pk__mark" src="/assets/images/logo-mark-white.svg" alt="" width="517" height="376" loading="lazy" />
                <img class="pk__word" src="/assets/images/logo-word-white.svg" alt="" width="1159" height="118" loading="lazy" />
                <span class="pk__dots"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
              </div>
              <div class="pk__body">
                <p class="pk__title">Seleziona la tua <span>installazione</span>.</p>
                <p class="pk__sub">Passa ad un’altra installazione.</p>
                <ul class="pk__list">
                  {multi.buildings.map((b, i) => (
                    <li class:list={['pk__row', { 'is-active': i === 0 }]} data-multi-row={b.id}>
                      <span class="pk__ico"></span>
                      <span class="pk__name">{b.app}<small>Collegata</small></span>
                      <span class="pk__more"></span>
                      <span class="pk__end"></span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="bld__rail" aria-hidden="true">
          {multi.buildings.map((b, i) => <span class:list={{ 'is-on': i === 0 }} data-multi-seg={b.id}></span>)}
        </div>
        <figcaption class="visually-hidden">Le proprietà Casa, Montagna e Ufficio nella stessa app Dymora.</figcaption>
      </figure>
    </div>

    <div class="bld__retro" id="ristrutturazioni" data-retro>
      <figure class="bld__stage bld__stage--retro" data-reveal="panel">
        <div class="bld__glow" aria-hidden="true"></div>
        <div class="bld__swap">
          <img class="bld__before" src={retrofit.options[0].src} alt={retrofit.options[0].alt} width="1600" height="1080" loading="lazy" decoding="async" />
          <img class="bld__after" src={retrofit.options[1].src} alt={retrofit.options[1].alt} width="1600" height="1080" loading="lazy" decoding="async" />
          <span class="bld__wipe" aria-hidden="true"></span>
        </div>
      </figure>
      <div class="bld__copy" data-reveal data-reveal-step="1">
        <Headline id="retrofit-title" size="l" text={retrofit.title} />
        <ul class="bld__opts">
          {retrofit.options.map((o, i) => (
            <li class="bld__opt" data-retro-opt={i}>
              <span class="w-label bld__opt-tag">{o.tag}</span>
              <Headline as="h3" size="s" text={o.title} />
              <p class="w-body w-muted">{o.body}</p>
            </li>
          ))}
        </ul>
        <Headline as="p" size="s" class="bld__close" text={retrofit.close} />
      </div>
    </div>
  </div>
</section>
<script is:inline src="/assets/js/buildings.js" defer></script>
