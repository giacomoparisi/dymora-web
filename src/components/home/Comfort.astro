---
// Brochure page `comfort` (`feature.lights`, `feature.covers`): the light fittings on panna, then on
// carbon the shutter and the awning beside the lit house (brochure piece). Every fitting and cover is a
// button: it plays its scene from dymora-app art/, nothing more.
import Eyebrow from '../Eyebrow.astro';
import Headline from '../Headline.astro';
import DeviceTile from '../DeviceTile.astro';

const lights = [
  { id: 'li-ceiling', sprite: 'ceiling_light', layer: 'glow_idle', name: 'Plafoniera', meta: 'Soggiorno' },
  { id: 'li-pendant', sprite: 'pendant_cone', layer: 'glow_idle', name: 'Lampada a calata', meta: 'Cucina' },
  { id: 'li-spot', sprite: 'light_recessed_spotlight', layer: 'lens_lit_mounted', name: 'Faretti del giardino', meta: 'Giardino' },
];
const covers = [
  { id: 'co-shutter', sprite: 'roller_shutter', layer: 'travel_frame!', name: 'Tapparella cucina' },
  { id: 'co-awning', sprite: 'awning', layer: 'extend_closed!', name: 'Tenda terrazza' },
];
---
<section class="comfort" aria-labelledby="lights-title">
  <div class="band band--ink" id="luci">
    <div class="band__inner comfort__lights">
      <div class="comfort__copy">
        <Eyebrow text="Luci" />
        <Headline id="lights-title" size="l" text="Gestisci l'impianto di illuminazione con **un click**." />
        <p class="w-lead w-muted">Controlla luci, colori e intensità tramite l'app.</p>
        <ul class="w-body points">
          <li>Accendi e spegni una luce, una stanza o tutte insieme.</li>
          <li>Regoli luminosità, colore e temperatura del bianco sulle lampade compatibili.</li>
          <li>Vedi se una luce non risponde.</li>
        </ul>
      </div>
      <div class="tile-row tile-row--3">
        {lights.map((l) => (
          <DeviceTile id={l.id} sprite={l.sprite} layers={l.layer} name={l.name} meta={l.meta} toggle={{ layer: l.layer, on: 'Accesa', off: 'Spenta', pressed: true }} />
        ))}
      </div>
    </div>
  </div>
  <div class="band band--ink" id="tapparelle">
    <div class="band__inner comfort__covers">
      <div class="comfort__copy">
        <Eyebrow text="Tende e tapparelle" />
        <Headline as="h3" size="m" text="Apri e chiudi tende e tapparelle **comodamente**." />
        <p class="w-lead w-muted">Imposta le tue routine, e dimenticati dei comandi fisici.</p>
        <ul class="w-body points">
          <li>Apri, chiudi e fermi tapparelle, tende e veneziane compatibili.</li>
          <li>Porti una tenda a una percentuale precisa, se il motore comunica la posizione.</li>
        </ul>
        <div class="tile-row tile-row--2 comfort__cover-tiles">
          {covers.map((c) => (
            <DeviceTile id={c.id} sprite={c.sprite} name={c.name} toggle={{ layer: c.layer, on: 'Chiusa', off: 'Aperta' }} />
          ))}
        </div>
      </div>
      <figure class="comfort__house">
        <img src="/assets/images/pieces/lights-house.webp" alt="La casa nell'app Dymora con le luci accese, gli scenari e le automazioni" width="1200" height="950" loading="lazy" />
      </figure>
      <p class="w-note w-muted comfort__note">Immagini dimostrative.</p>
    </div>
  </div>
</section>
