---
// Brochure pages 2–4 (`overview`, `multi`, `retrofit`) as one bento section, chosen on
// 2026-11-24 among the layout prototypes: about one screen on desktop instead of three.
// Wide (>=1100px): the house in the large tile on the left, properties and retrofit
// stacked on the right (`.intro__grid`, home.css). Phone: the three tiles one after another.
// The house plays its functions one at a time (overview.js); the properties light up
// one at a time and their branch of the orange comb runs to the devices (multi.js),
// whose screens show the app's installation picker (Casa, Montagna, Ufficio).
// In retrofit an arrow leads from each picture to its title, and both options join
// into the closing line. Anchors kept for the site header:
// #panoramica, #edifici, #ristrutturazioni.
import Headline from '../Headline.astro';
import Sprite from '../Sprite.astro';
import { overview, multi, retrofit } from '../../data/intro';
---
<section class="band band--ink intro" id="panoramica" aria-labelledby="overview-title">
  <div class="band__inner intro__grid">
    <article class="intro__tile intro__tile--house" data-reveal="panel">
      <div class="intro__copy">
        <Headline id="overview-title" size="m" text={overview.title} />
        <p class="w-body w-muted">{overview.lead}</p>
      </div>
      <div class="intro__fit">
      <div class="ov-stage" data-ov-sequence={overview.sequence.join(' ')} data-ov-rest={overview.rest}>
        <div class="ov-house">
          <Sprite id="ov-house" name="house" variant="dark" layers={overview.rest} order={overview.order} alt={overview.alt} />
          <div class="ov-items" aria-hidden="true">
            {overview.items.map((item) => (
              <div class:list={['ov-item', `ov-item--${item.row}`, `ov-i--${item.id}`]} data-ov-item={item.id} data-ov-on={item.on} data-ov-off={item.off}>
                <span class="ov-lead"></span>
                <span class="tag ov-tag">{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      </div>
    </article>

    <article class="intro__tile intro__tile--multi" id="edifici" aria-labelledby="multi-title" data-reveal="panel" data-reveal-step="1">
      <Headline id="multi-title" size="s" text={multi.title} />
      <div class="intro__props" data-multi>
        <ul class="intro__buildings">
          {multi.buildings.map((b) => (
            <li data-multi-item={b.id}>
              <img src={b.src} alt="" width={b.w} height={b.h} loading="lazy" />
              <span class="tag">{b.label}</span>
            </li>
          ))}
        </ul>
        <div class="intro__comb" aria-hidden="true">
          {multi.buildings.map((b) => <span class={`intro__drop intro__drop--${b.id}`} data-multi-path={b.id}></span>)}
          {multi.buildings.map((b) => <span class={`intro__bus intro__bus--${b.id}`} data-multi-path={b.id}></span>)}
          <span class="intro__trunk"></span>
        </div>
        <div class="intro__screens">
          <div class="intro__devices" aria-hidden="true">
            {multi.devices.map((d) => (
              <div class={`mdev mdev--${d}`}>
                <span class="mdev__screen">{d === 'phone'
                  ? <img src="/assets/images/installation-selection-compact-dark.webp" alt="" width="1644" height="3564" loading="lazy" />
                  : <img src="/assets/images/installation-selection-expanded-dark.webp" alt="" width="3840" height="2400" loading="lazy" />}</span>
              </div>
            ))}
          </div>
          <p class="w-body-strong intro__line">{multi.line}</p>
        </div>
      </div>
    </article>

    <article class="intro__tile intro__tile--retro" id="ristrutturazioni" aria-labelledby="retrofit-title" data-reveal="panel" data-reveal-step="2">
      <Headline id="retrofit-title" size="s" text={retrofit.title} />
      <ul class="intro__options">
        {retrofit.options.map((o) => (
          <li>
            <figure>
              <span class="tag tag--accent">{o.tag}</span>
              <img src={o.src} alt={o.alt} width="1600" height="1080" loading="lazy" />
            </figure>
            <span class="intro__flow" aria-hidden="true"></span>
            <Headline as="h3" size="s" text={o.title} />
            <p class="w-note w-muted">{o.body}</p>
          </li>
        ))}
      </ul>
      <div class="intro__join" aria-hidden="true"><span class="intro__join-bus"></span><span class="intro__flow"></span></div>
      <Headline as="p" size="s" class="intro__close" text={retrofit.close} />
    </article>
  </div>
</section>
<script is:inline src="/assets/js/overview.js" defer></script>
<script is:inline src="/assets/js/multi.js" defer></script>
